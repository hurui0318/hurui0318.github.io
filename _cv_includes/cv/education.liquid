{% comment %}
  Local override of al_folio_cv's cv/education.liquid.

  Differences from the gem template:
  - The entry list has no bullet markers / left indent.
  - The institution logo from _data/cv_logos.yml is shown under the date badge.
  Styling lives in assets/css/custom.css.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign institution_name = entry.institution | strip %}
    {% assign entry_logo = '' %}
    {% for logo in site.data.cv_logos %}
      {% if institution_name contains logo.match %}
        {% assign entry_logo = logo.image %}
        {% break %}
      {% endif %}
    {% endfor %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          {% comment %} `capture` keeps the surrounding whitespace, so strip before testing for emptiness {% endcomment %}
          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date | strip %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date = end_date | strip %}
          {% comment %}
            An entry may carry a single point-in-time `date` instead of a start/end pair. `al_cv_sort_by_date` already
            orders on it, so render it too rather than silently dropping the badge.
          {% endcomment %}
          {% capture point_date %}
            {% if entry.date %}{{ entry.date }}{% elsif entry.releaseDate %}{{ entry.releaseDate }}{% endif %}
          {% endcapture %}
          {% assign point_date = point_date | strip %}

          {% if start_date != '' %}
            {% comment %} Extract year only from dates like "1933-01-01" or just use "1933" as is {% endcomment %}
            {% assign startDate = start_date | split: '-' | first %}
            {% assign endDate = end_date | split: '-' | first | default: 'Now' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% elsif point_date != '' %}
            {% comment %} A standalone date is a point in time, never an open-ended range, so it renders as a single year {% endcomment %}
            {% assign date = point_date | split: '-' | first %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold text-uppercase align-middle cv-date-badge">
                      {{- date -}}
                    </span>
                  {% endif %}
                </td>
              </tr>
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% assign location = location | strip %}
              {% if location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
              {% if entry_logo != '' %}
                <tr>
                  <td>
                    <div class="cv-logo">
                      <img src="{{ '/assets/img/' | append: entry_logo | relative_url }}" alt="{{ institution_name }} logo" loading="lazy">
                    </div>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}

          {% if entry.url %}
            <h6 class="title cv-entry-title">
              <a href="{{ entry.url }}">{{ study_type }}</a>
            </h6>
          {% elsif study_type != '' %}
            <h6 class="title cv-entry-title">{{ study_type }}</h6>
          {% endif %}

          {% if entry.institution %}
            <div class="cv-entry-org">{{ entry.institution }}</div>
          {% endif %}

          {% if entry.area %}
            <div class="cv-entry-summary">{{ entry.area }}</div>
          {% endif %}

          {% if entry.courses or entry.highlights %}
            <ul class="items">
              {% for item in entry.courses %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
